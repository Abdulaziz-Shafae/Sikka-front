# Server-only backend origin. No trailing API path or credentials.
SIKKA_BACKEND_URL=http://localhost:8080
# Same-origin gateway avoids browser CORS for the existing Basic Auth contract.
NEXT_PUBLIC_SIKKA_API_URL=/api/backend
# Existing planner remains an explicitly local preview until screen binding is complete.
NEXT_PUBLIC_SIKKA_DEMO_MODE=true
# Publishable key only. Never put MOYASAR_SECRET_KEY in this frontend.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
